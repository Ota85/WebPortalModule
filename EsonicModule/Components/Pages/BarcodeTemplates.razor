@page "/barcodetemplates"
@using EsonicModule.DTOs
@using EsonicModule.Services
@using Microsoft.JSInterop
@inject IZebraTemplateService ZebraTemplateService
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Šablony čárových kódů</PageTitle>

@* <h1>Barcode Templates</h1> *@

<p>Správa šablon čárových kódů</p>

@if (isLoading)
{
    <p><em>Načítání...</em></p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success" role="alert">
            @successMessage
        </div>
    }

    <div class="action-section">
        <button class="btn btn-success" @onclick="AddNewRow">
            <span class="bi bi-plus-circle" aria-hidden="true"></span> Přidat novou šablonu
        </button>
    </div>

    <!-- Table Container with Edge 86 compatible scrolling -->
    <div class="table-container">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Název</th>
                    <th>Popis</th>
                    <th>Šablona</th>
                    <th>Akce</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int index = 0;
                }
                @foreach (var template in editableTemplates)
                {
                    var currentIndex = index;
                    <tr class="@GetRowClass(template)">
                        <td>
                            <input type="text" class="form-control" @bind="template.Name" @bind:event="oninput" @bind:after="() => MarkAsModified(template)" />
                        </td>
                        <td>
                            <input type="text" class="form-control" @bind="template.Description" @bind:event="oninput" @bind:after="() => MarkAsModified(template)" />
                        </td>
                        <td>
                            <textarea class="form-control" rows="3" @bind="template.Template" @bind:event="oninput" @bind:after="() => MarkAsModified(template)"></textarea>
                        </td>
                        <td>
                            <button class="btn btn-danger btn-sm" @onclick="() => RemoveRow(index)">
                                <span class="bi bi-trash" aria-hidden="true"></span> Odebrat
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (editableTemplates.Count == 0)
    {
        <div class="alert alert-info" role="alert">
            Nebyly nalezeny žádné šablony čárových kódů. Klikněte na "Přidat novou šablonu" pro přidání.
        </div>
    }

    <div class="mt-3">
        <button class="btn btn-secondary" @onclick="CancelChanges">
            <span class="bi bi-x-circle" aria-hidden="true"></span> Zrušit
        </button>
        <button class="btn btn-primary ms-2" @onclick="SaveChanges" disabled="@(!HasChanges())">
            <span class="bi bi-save" aria-hidden="true"></span> Uložit
        </button>
    </div>
}

<style>
    .row-new {
        background-color: #d4edda !important;
    }

    .row-modified {
        background-color: #fff3cd !important;
    }
</style>

@code {
    private List<ZebraTemplateViewModel> editableTemplates = new();
    private List<ZebraTemplateDto> originalTemplates = new();
    private bool isLoading = true;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            successMessage = null;

            var templates = await ZebraTemplateService.GetAllAsync();
            originalTemplates = templates.Select(t => new ZebraTemplateDto
            {
                Id = t.Id,
                Name = t.Name,
                Description = t.Description,
                Template = t.Template
            }).ToList();

            editableTemplates = templates.Select(t => new ZebraTemplateViewModel
            {
                Id = t.Id,
                Name = t.Name,
                Description = t.Description,
                Template = t.Template,
                IsNew = false,
                IsModified = false
            }).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = string.Format("Chyba při načítání šablon čárových kódů: {0}", ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void AddNewRow()
    {
        editableTemplates.Add(new ZebraTemplateViewModel
        {
            Id = 0,
            Name = string.Empty,
            Description = string.Empty,
            Template = string.Empty,
            IsNew = true,
            IsModified = false
        });
        successMessage = null;
    }

    private async Task RemoveRow(int index)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirmDialog.show", "Opravdu chcete SMAZAT tuto šablonu čárového kódu?");
        if (confirmed)
        {
            editableTemplates.RemoveAt(index);
            successMessage = null;
        }
    }

    private void MarkAsModified(ZebraTemplateViewModel template)
    {
        if (!template.IsNew)
        {
            // Check if values have actually changed from original
            var original = originalTemplates.FirstOrDefault(o => o.Id == template.Id);
            if (original != null)
            {
                template.IsModified = 
                    template.Name != original.Name ||
                    template.Description != original.Description ||
                    template.Template != original.Template;
            }
        }
        successMessage = null;
    }

    private string GetRowClass(ZebraTemplateViewModel template)
    {
        if (template.IsNew)
            return "row-new";
        if (template.IsModified)
            return "row-modified";
        return string.Empty;
    }

    private bool HasChanges()
    {
        return editableTemplates.Any(t => t.IsNew || t.IsModified);
    }

    private async Task SaveChanges()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirmDialog.show", "ULOŽIT změny?");
        if (!confirmed)
        {
            return;
        }

        try
        {
            errorMessage = null;
            successMessage = null;

            // Validate input
            foreach (var template in editableTemplates)
            {
                if (string.IsNullOrWhiteSpace(template.Name))
                {
                    errorMessage = "Název je povinný pro všechny šablony čárových kódů.";
                    return;
                }
                if (string.IsNullOrWhiteSpace(template.Template))
                {
                    errorMessage = "Šablona je povinná pro všechny šablony čárových kódů.";
                    return;
                }
            }

            // Get only new or modified templates
            var templatesToSave = editableTemplates
                .Where(t => t.IsNew || t.IsModified)
                .Select(t => new ZebraTemplateDto
                {
                    Id = t.Id,
                    Name = t.Name,
                    Description = t.Description ?? string.Empty,
                    Template = t.Template
                })
                .ToList();

            if (templatesToSave.Any())
            {
                await ZebraTemplateService.SaveChangesAsync(templatesToSave);
                successMessage = "Šablony čárových kódů úspěšně uloženy!";
                
                // Reload data to refresh with saved IDs and clear flags
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            errorMessage = string.Format("Chyba při ukládání šablon čárových kódů: {0}", ex.Message);
        }
    }

    private async Task CancelChanges()
    {
        successMessage = null;
        errorMessage = null;
        await LoadData();
    }

    // ViewModel to track state
    private class ZebraTemplateViewModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string Template { get; set; } = string.Empty;
        public bool IsNew { get; set; }
        public bool IsModified { get; set; }
    }
}
