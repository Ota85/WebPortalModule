@page "/printersettings"
@using EsonicModule.DTOs
@using EsonicModule.Services
@using System.Net
@using Microsoft.JSInterop
@inject IPrinterSettingService PrinterSettingService
@inject IJSRuntime JS
@rendermode InteractiveServer

@* <PageTitle>Nastavení tiskáren</PageTitle> *@

<p>Správa konfigurace tiskáren</p>

@if (isLoading)
{
    <p><em>Načítání...</em></p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success" role="alert">
            @successMessage
        </div>
    }

    <div class="action-section">
        <button class="btn btn-success" @onclick="AddNewRow">
            <span class="bi bi-plus-circle" aria-hidden="true"></span> Přidat novou tiskárnu
        </button>
    </div>

    <!-- Table Container with Edge 86 compatible scrolling -->
    <div class="table-container">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Název</th>
                    <th>Popis</th>
                    <th>IP adresa</th>
                    <th>Port</th>
                    <th>Akce</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int index = 0;
                }
                @foreach (var setting in editableSettings)
                {
                    var currentIndex = index;
                    <tr class="@GetRowClass(setting)">
                        <td>
                            <input type="text" class="form-control" 
                                   value="@setting.Name" 
                                   @onchange="@(e => UpdateSettingName(setting, e.Value?.ToString()))" />
                        </td>
                        <td>
                            <input type="text" class="form-control" 
                                   value="@setting.Description" 
                                   @onchange="@(e => UpdateSettingDescription(setting, e.Value?.ToString()))" />
                        </td>
                        <td>
                            <input type="text" class="form-control" 
                                   value="@setting.IPAddress" 
                                   @onchange="@(e => UpdateSettingIPAddress(setting, e.Value?.ToString()))" />
                        </td>
                        <td>
                            <input type="number" class="form-control" 
                                   value="@setting.Port" 
                                   min="@MinPort" 
                                   max="@MaxPort"
                                   @onchange="@(e => UpdateSettingPort(setting, e.Value?.ToString()))" />
                        </td>
                        <td>
                            <button class="btn btn-danger btn-sm" @onclick="@(() => RemoveRow(currentIndex))">
                                <span class="bi bi-trash" aria-hidden="true"></span> Odebrat
                            </button>
                        </td>
                    </tr>
                    index++;
                }
            </tbody>
        </table>
    </div>

    @if (editableSettings.Count == 0)
    {
        <div class="alert alert-info" role="alert">
            Nebyly nalezeny žádné nastavení tiskáren. Klikněte na "Přidat novou tiskárnu" pro přidání.
        </div>
    }

    <div class="action-buttons">
        <button class="btn btn-secondary" @onclick="CancelChanges">
            <span class="bi bi-x-circle" aria-hidden="true"></span> Zrušit
        </button>
        <button class="btn btn-primary button-spacing" @onclick="SaveChanges" disabled="@(!HasChanges())">
            <span class="bi bi-save" aria-hidden="true"></span> Uložit
        </button>
    </div>
}

<!-- Edge 86 Compatible CSS -->
