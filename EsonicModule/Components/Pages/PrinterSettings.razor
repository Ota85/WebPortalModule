@code {
    private const int DefaultPrinterPort = 9100;
    private const int MinPort = 1;
    private const int MaxPort = 65535;

    private List<PrinterSettingViewModel> editableSettings = new();
    private List<PrinterSettingDto> originalSettings = new();
    private bool isLoading = true;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            successMessage = null;

            var settings = await PrinterSettingService.GetAllAsync();
            
            // Edge 86 compatible - avoid LINQ Select with complex expressions
            originalSettings = new List<PrinterSettingDto>();
            foreach (var s in settings)
            {
                originalSettings.Add(new PrinterSettingDto
                {
                    Id = s.Id,
                    Name = s.Name,
                    Description = s.Description,
                    IPAddress = s.IPAddress,
                    Port = s.Port
                });
            }

            editableSettings = new List<PrinterSettingViewModel>();
            foreach (var s in settings)
            {
                editableSettings.Add(new PrinterSettingViewModel
                {
                    Id = s.Id,
                    Name = s.Name,
                    Description = s.Description,
                    IPAddress = s.IPAddress,
                    Port = s.Port,
                    IsNew = false,
                    IsModified = false
                });
            }
        }
        catch (Exception ex)
        {
            errorMessage = string.Format("Chyba při načítání nastavení tiskáren: {0}", ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void AddNewRow()
    {
        editableSettings.Add(new PrinterSettingViewModel
        {
            Id = 0,
            Name = string.Empty,
            Description = string.Empty,
            IPAddress = string.Empty,
            Port = DefaultPrinterPort,
            IsNew = true,
            IsModified = false
        });
        successMessage = null;
    }

    private async Task RemoveRow(int index)
    {
        // Use standard JavaScript confirm for Edge 86 compatibility
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Opravdu chcete SMAZAT toto nastavení tiskárny?");
        if (confirmed)
        {
            if (index >= 0 && index < editableSettings.Count)
            {
                editableSettings.RemoveAt(index);
                successMessage = null;
                StateHasChanged();
            }
        }
    }

    // Edge 86 compatible update methods
    private void UpdateSettingName(PrinterSettingViewModel setting, string? newValue)
    {
        setting.Name = newValue ?? string.Empty;
        MarkAsModified(setting);
        StateHasChanged();
    }

    private void UpdateSettingDescription(PrinterSettingViewModel setting, string? newValue)
    {
        setting.Description = newValue;
        MarkAsModified(setting);
        StateHasChanged();
    }

    private void UpdateSettingIPAddress(PrinterSettingViewModel setting, string? newValue)
    {
        setting.IPAddress = newValue ?? string.Empty;
        MarkAsModified(setting);
        StateHasChanged();
    }

    private void UpdateSettingPort(PrinterSettingViewModel setting, string? newValue)
    {
        if (int.TryParse(newValue, out int port))
        {
            setting.Port = port;
        }
        else
        {
            setting.Port = DefaultPrinterPort;
        }
        MarkAsModified(setting);
        StateHasChanged();
    }

    private void MarkAsModified(PrinterSettingViewModel setting)
    {
        if (!setting.IsNew)
        {
            // Edge 86 compatible - avoid LINQ FirstOrDefault
            PrinterSettingDto? original = null;
            foreach (var o in originalSettings)
            {
                if (o.Id == setting.Id)
                {
                    original = o;
                    break;
                }
            }

            if (original != null)
            {
                setting.IsModified = 
                    setting.Name != original.Name ||
                    setting.Description != original.Description ||
                    setting.IPAddress != original.IPAddress ||
                    setting.Port != original.Port;
            }
        }
        successMessage = null;
    }

    private string GetRowClass(PrinterSettingViewModel setting)
    {
        if (setting.IsNew)
            return "row-new";
        if (setting.IsModified)
            return "row-modified";
        return string.Empty;
    }

    private bool HasChanges()
    {
        // Edge 86 compatible - avoid LINQ Any
        foreach (var setting in editableSettings)
        {
            if (setting.IsNew || setting.IsModified)
                return true;
        }
        return false;
    }

    private async Task SaveChanges()
    {
        // Use standard JavaScript confirm for Edge 86 compatibility
        var confirmed = await JS.InvokeAsync<bool>("confirm", "ULOŽIT změny?");
        if (!confirmed)
        {
            return;
        }

        try
        {
            errorMessage = null;
            successMessage = null;

            // Validate input
            foreach (var setting in editableSettings)
            {
                if (string.IsNullOrWhiteSpace(setting.Name))
                {
                    errorMessage = "Název je povinný pro všechna nastavení tiskáren.";
                    return;
                }
                if (string.IsNullOrWhiteSpace(setting.IPAddress))
                {
                    errorMessage = "IP adresa je povinná pro všechna nastavení tiskáren.";
                    return;
                }
                if (!IPAddress.TryParse(setting.IPAddress, out _))
                {
                    errorMessage = string.Format("Neplatný formát IP adresy: {0}", setting.IPAddress);
                    return;
                }
                if (setting.Port < MinPort || setting.Port > MaxPort)
                {
                    errorMessage = string.Format("Port musí být mezi {0} a {1}.", MinPort, MaxPort);
                    return;
                }
            }

            // Edge 86 compatible - avoid LINQ Where/Select
            var settingsToSave = new List<PrinterSettingDto>();
            foreach (var s in editableSettings)
            {
                if (s.IsNew || s.IsModified)
                {
                    settingsToSave.Add(new PrinterSettingDto
                    {
                        Id = s.Id,
                        Name = s.Name,
                        Description = s.Description ?? string.Empty,
                        IPAddress = s.IPAddress,
                        Port = s.Port
                    });
                }
            }

            if (settingsToSave.Count > 0)
            {
                await PrinterSettingService.SaveChangesAsync(settingsToSave);
                successMessage = "Nastavení tiskáren úspěšně uloženo!";
                
                // Reload data to refresh with saved IDs and clear flags
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            errorMessage = string.Format("Chyba při ukládání nastavení tiskáren: {0}", ex.Message);
        }
    }

    private async Task CancelChanges()
    {
        successMessage = null;
        errorMessage = null;
        await LoadData();
    }

    // ViewModel to track state
    private class PrinterSettingViewModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string IPAddress { get; set; } = string.Empty;
        public int Port { get; set; }
        public bool IsNew { get; set; }
        public bool IsModified { get; set; }
    }
}
