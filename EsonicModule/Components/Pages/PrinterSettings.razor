@page "/printersettings"
@using EsonicModule.DTOs
@using EsonicModule.Services
@using System.Net
@using Microsoft.JSInterop
@inject IPrinterSettingService PrinterSettingService
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Printer Settings</PageTitle>

@* <h1>Printer Settings</h1> *@

<p>Manage printer configurations</p>

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success" role="alert">
            @successMessage
        </div>
    }

    <div class="mb-3">
        <button class="btn btn-success" @onclick="AddNewRow">
            <span class="bi bi-plus-circle" aria-hidden="true"></span> Add New Printer
        </button>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>IP Address</th>
                    <th>Port</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var (setting, index) in editableSettings.Select((s, i) => (s, i)))
                {
                    <tr class="@GetRowClass(setting)">
                        <td>
                            <input type="text" class="form-control" @bind="setting.Name" @bind:event="oninput" @bind:after="() => MarkAsModified(setting)" />
                        </td>
                        <td>
                            <input type="text" class="form-control" @bind="setting.Description" @bind:event="oninput" @bind:after="() => MarkAsModified(setting)" />
                        </td>
                        <td>
                            <input type="text" class="form-control" @bind="setting.IPAddress" @bind:event="oninput" @bind:after="() => MarkAsModified(setting)" />
                        </td>
                        <td>
                            <input type="number" class="form-control" @bind="setting.Port" @bind:event="oninput" @bind:after="() => MarkAsModified(setting)" />
                        </td>
                        <td>
                            <button class="btn btn-danger btn-sm" @onclick="() => RemoveRow(index)">
                                <span class="bi bi-trash" aria-hidden="true"></span> Remove
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (editableSettings.Count == 0)
    {
        <div class="alert alert-info" role="alert">
            No printer settings found. Click "Add New Printer" to add one.
        </div>
    }

    <div class="mt-3">
        <button class="btn btn-secondary" @onclick="CancelChanges">
            <span class="bi bi-x-circle" aria-hidden="true"></span> Cancel
        </button>
        <button class="btn btn-primary ms-2" @onclick="SaveChanges" disabled="@(!HasChanges())">
            <span class="bi bi-save" aria-hidden="true"></span> Save
        </button>
    </div>
}

<style>
    .row-new {
        background-color: #d4edda !important;
    }

    .row-modified {
        background-color: #fff3cd !important;
    }
</style>

@code {
    private const int DefaultPrinterPort = 9100;
    private const int MinPort = 1;
    private const int MaxPort = 65535;

    private List<PrinterSettingViewModel> editableSettings = new();
    private List<PrinterSettingDto> originalSettings = new();
    private bool isLoading = true;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            successMessage = null;

            var settings = await PrinterSettingService.GetAllAsync();
            originalSettings = settings.Select(s => new PrinterSettingDto
            {
                Id = s.Id,
                Name = s.Name,
                Description = s.Description,
                IPAddress = s.IPAddress,
                Port = s.Port
            }).ToList();

            editableSettings = settings.Select(s => new PrinterSettingViewModel
            {
                Id = s.Id,
                Name = s.Name,
                Description = s.Description,
                IPAddress = s.IPAddress,
                Port = s.Port,
                IsNew = false,
                IsModified = false
            }).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading printer settings: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void AddNewRow()
    {
        editableSettings.Add(new PrinterSettingViewModel
        {
            Id = 0,
            Name = string.Empty,
            Description = string.Empty,
            IPAddress = string.Empty,
            Port = DefaultPrinterPort,
            IsNew = true,
            IsModified = false
        });
        successMessage = null;
    }

    private async Task RemoveRow(int index)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirmDialog.show", "Are you sure you want to remove this printer setting?");
        if (confirmed)
        {
            editableSettings.RemoveAt(index);
            successMessage = null;
        }
    }

    private void MarkAsModified(PrinterSettingViewModel setting)
    {
        if (!setting.IsNew)
        {
            // Check if values have actually changed from original
            var original = originalSettings.FirstOrDefault(o => o.Id == setting.Id);
            if (original != null)
            {
                setting.IsModified = 
                    setting.Name != original.Name ||
                    setting.Description != original.Description ||
                    setting.IPAddress != original.IPAddress ||
                    setting.Port != original.Port;
            }
        }
        successMessage = null;
    }

    private string GetRowClass(PrinterSettingViewModel setting)
    {
        if (setting.IsNew)
            return "row-new";
        if (setting.IsModified)
            return "row-modified";
        return string.Empty;
    }

    private bool HasChanges()
    {
        return editableSettings.Any(s => s.IsNew || s.IsModified);
    }

    private async Task SaveChanges()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirmDialog.show", "Are you sure you want to save these changes?");
        if (!confirmed)
        {
            return;
        }

        try
        {
            errorMessage = null;
            successMessage = null;

            // Validate input
            foreach (var setting in editableSettings)
            {
                if (string.IsNullOrWhiteSpace(setting.Name))
                {
                    errorMessage = "Name is required for all printer settings.";
                    return;
                }
                if (string.IsNullOrWhiteSpace(setting.IPAddress))
                {
                    errorMessage = "IP Address is required for all printer settings.";
                    return;
                }
                if (!IPAddress.TryParse(setting.IPAddress, out _))
                {
                    errorMessage = $"Invalid IP Address format: {setting.IPAddress}";
                    return;
                }
                if (setting.Port < MinPort || setting.Port > MaxPort)
                {
                    errorMessage = $"Port must be between {MinPort} and {MaxPort}.";
                    return;
                }
            }

            // Get only new or modified settings
            var settingsToSave = editableSettings
                .Where(s => s.IsNew || s.IsModified)
                .Select(s => new PrinterSettingDto
                {
                    Id = s.Id,
                    Name = s.Name,
                    Description = s.Description ?? string.Empty,
                    IPAddress = s.IPAddress,
                    Port = s.Port
                })
                .ToList();

            if (settingsToSave.Any())
            {
                await PrinterSettingService.SaveChangesAsync(settingsToSave);
                successMessage = "Printer settings saved successfully!";
                
                // Reload data to refresh with saved IDs and clear flags
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving printer settings: {ex.Message}";
        }
    }

    private async Task CancelChanges()
    {
        successMessage = null;
        errorMessage = null;
        await LoadData();
    }

    // ViewModel to track state
    private class PrinterSettingViewModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string IPAddress { get; set; } = string.Empty;
        public int Port { get; set; }
        public bool IsNew { get; set; }
        public bool IsModified { get; set; }
    }
}
