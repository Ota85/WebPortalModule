@page "/"
@using EsonicModule.Models
@using EsonicModule.Services
@inject IBarcodeService BarcodeService
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

<p>Welcome to your new app.</p>

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>ZPL Code</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var barcode in barcodes)
                {
                    <tr>
                        <td>@barcode.ID</td>
                        <td>@barcode.ZPLCode</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Barcode> barcodes = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        // Load barcodes from database
        barcodes = await BarcodeService.GetAllBarcodesAsync();
        
        isLoading = false;
    }
}
