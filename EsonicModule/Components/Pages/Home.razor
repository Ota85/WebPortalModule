@page "/"
@using EsonicModule.Models
@using EsonicModule.Services
@inject IBarcodeService BarcodeService
@rendermode InteractiveServer

<PageTitle>Barcodes</PageTitle>

<h1>ZEBRA Barcodes</h1>

<p>barcodes from DB Zebra for print</p>

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>ZPL Code</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var barcode in barcodes)
                {
                    <tr>
                        <td>@barcode.ID</td>
                        <td>@barcode.ZPLCode</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Barcode> barcodes = new();
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Load barcodes from database
            barcodes = await BarcodeService.GetAllBarcodesAsync() ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading barcodes: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
