@code {
    private List<MaterialStockStageDto> materialStockStages = new();
    private List<MaterialStockStageDto>? cachedFilteredData;
    private List<PrinterSettingDto> printerSettings = new();
    private List<ZebraTemplateDto> zebraTemplates = new();
    private int selectedPrinterId = 0;
    private int selectedTemplateId = 0;
    private bool isLoading = true;
    private string? errorMessage;
    private bool isPrinting = false;
    private string printMessage = string.Empty;
    
    // Date filtering
    private DateTime? filterDateFrom;
    private DateTime? filterDateTo;
    
    // Filtering
    private string filterMaterialBatch = string.Empty;
    private string filterMaterialNumber = string.Empty;
    private string filterStorage = string.Empty;
    
    // Sorting
    private string sortColumn = string.Empty;
    private bool sortAscending = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Initial load without date filters - loads top 250 by TimeStamp descending
            materialStockStages = await MaterialStockStageService.GetAllAsync() ?? new();
            printerSettings = await PrinterSettingService.GetAllAsync() ?? new();
            zebraTemplates = await ZebraTemplateService.GetAllAsync() ?? new();
            UpdateFilteredData();
        }
        catch (Exception ex)
        {
            errorMessage = string.Format("Chyba při načítání skladových dat materiálu: {0}", ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    // Edge 86 compatible event handlers
    private void OnPrinterChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int printerId))
        {
            selectedPrinterId = printerId;
        }
        StateHasChanged();
    }

    private void OnTemplateChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int templateId))
        {
            selectedTemplateId = templateId;
        }
        StateHasChanged();
    }

    private void OnDateFromChanged(ChangeEventArgs e)
    {
        var dateValue = e.Value?.ToString();
        if (DateTime.TryParse(dateValue, out DateTime parsedDate))
        {
            filterDateFrom = parsedDate;
        }
        else
        {
            filterDateFrom = null;
        }
        StateHasChanged();
    }

    private void OnDateToChanged(ChangeEventArgs e)
    {
        var dateValue = e.Value?.ToString();
        if (DateTime.TryParse(dateValue, out DateTime parsedDate))
        {
            filterDateTo = parsedDate;
        }
        else
        {
            filterDateTo = null;
        }
        StateHasChanged();
    }

    private void OnMaterialNumberFilterChanged(ChangeEventArgs e)
    {
        filterMaterialNumber = e.Value?.ToString() ?? string.Empty;
        UpdateFilteredData();
        StateHasChanged();
    }

    private void OnMaterialBatchFilterChanged(ChangeEventArgs e)
    {
        filterMaterialBatch = e.Value?.ToString() ?? string.Empty;
        UpdateFilteredData();
        StateHasChanged();
    }

    private void OnStorageFilterChanged(ChangeEventArgs e)
    {
        filterStorage = e.Value?.ToString() ?? string.Empty;
        UpdateFilteredData();
        StateHasChanged();
    }

    private async Task ReloadData()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            StateHasChanged();

            // Reload data from service with date filters
            materialStockStages = await MaterialStockStageService.GetAllAsync(filterDateFrom, filterDateTo) ?? new();
            UpdateFilteredData();
        }
        catch (Exception ex)
        {
            errorMessage = string.Format("Chyba při načítání skladových dat materiálu: {0}", ex.Message);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ClearDateFilters()
    {
        filterDateFrom = null;
        filterDateTo = null;
        await ReloadData();
    }

    private List<MaterialStockStageDto> FilteredData => cachedFilteredData ?? new List<MaterialStockStageDto>();

    private void UpdateFilteredData()
    {
        var filtered = materialStockStages.AsEnumerable();

        // Apply filters using traditional loops instead of LINQ for better compatibility
        var tempList = new List<MaterialStockStageDto>();
        
        foreach (var item in materialStockStages)
        {
            bool includeItem = true;

            // Material number filter
            if (!string.IsNullOrWhiteSpace(filterMaterialNumber))
            {
                if (!item.MaterialNumber.HasValue || 
                    !item.MaterialNumber.Value.ToString().Contains(filterMaterialNumber))
                {
                    includeItem = false;
                }
            }

            // Material batch filter
            if (includeItem && !string.IsNullOrWhiteSpace(filterMaterialBatch))
            {
                if (string.IsNullOrEmpty(item.MaterialBatch) || 
                    item.MaterialBatch.IndexOf(filterMaterialBatch, StringComparison.OrdinalIgnoreCase) < 0)
                {
                    includeItem = false;
                }
            }

            // Storage filter
            if (includeItem && !string.IsNullOrWhiteSpace(filterStorage))
            {
                if (string.IsNullOrEmpty(item.Storage) || 
                    item.Storage.IndexOf(filterStorage, StringComparison.OrdinalIgnoreCase) < 0)
                {
                    includeItem = false;
                }
            }

            if (includeItem)
            {
                tempList.Add(item);
            }
        }

        // Apply sorting manually for Edge 86 compatibility
        if (!string.IsNullOrEmpty(sortColumn))
        {
            switch (sortColumn)
            {
                case "MaterialNumber":
                    tempList.Sort((x, y) => sortAscending 
                        ? Comparer<int?>.Default.Compare(x.MaterialNumber, y.MaterialNumber)
                        : Comparer<int?>.Default.Compare(y.MaterialNumber, x.MaterialNumber));
                    break;
                case "MaterialBatch":
                    tempList.Sort((x, y) => sortAscending 
                        ? string.Compare(x.MaterialBatch, y.MaterialBatch, StringComparison.OrdinalIgnoreCase)
                        : string.Compare(y.MaterialBatch, x.MaterialBatch, StringComparison.OrdinalIgnoreCase));
                    break;
                case "Storage":
                    tempList.Sort((x, y) => sortAscending 
                        ? string.Compare(x.Storage, y.Storage, StringComparison.OrdinalIgnoreCase)
                        : string.Compare(y.Storage, x.Storage, StringComparison.OrdinalIgnoreCase));
                    break;
                case "TimeStamp":
                    tempList.Sort((x, y) => sortAscending 
                        ? DateTime.Compare(x.TimeStamp ?? DateTime.MinValue, y.TimeStamp ?? DateTime.MinValue)
                        : DateTime.Compare(y.TimeStamp ?? DateTime.MinValue, x.TimeStamp ?? DateTime.MinValue));
                    break;
            }
        }

        cachedFilteredData = tempList;
    }

    private void SortBy(string columnName)
    {
        if (sortColumn == columnName)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = columnName;
            sortAscending = true;
        }
        UpdateFilteredData();
        StateHasChanged();
    }

    // Edge 86 compatible date formatting
    private string FormatDateTime(DateTime? dateTime)
    {
        if (dateTime.HasValue)
        {
            return dateTime.Value.ToString("yyyy-MM-dd HH:mm:ss");
        }
        return string.Empty;
    }

    // Edge 86 compatible printer finding
    private PrinterSettingDto? FindPrinterById(int id)
    {
        foreach (var printer in printerSettings)
        {
            if (printer.Id == id)
            {
                return printer;
            }
        }
        return null;
    }

    // Edge 86 compatible template finding
    private ZebraTemplateDto? FindTemplateById(int id)
    {
        foreach (var template in zebraTemplates)
        {
            if (template.Id == id)
            {
                return template;
            }
        }
        return null;
    }

    private async Task PrintItem(MaterialStockStageDto item)
    {
        try
        {
            printMessage = string.Empty;
            errorMessage = string.Empty;

            // Validate selections
            if (selectedPrinterId == 0)
            {
                errorMessage = "Prosím vyberte tiskárnu.";
                return;
            }

            if (selectedTemplateId == 0)
            {
                errorMessage = "Prosím vyberte šablonu.";
                return;
            }

            var printer = FindPrinterById(selectedPrinterId);
            var template = FindTemplateById(selectedTemplateId);

            if (printer == null)
            {
                errorMessage = "Vybraná tiskárna nebyla nalezena.";
                return;
            }

            if (template == null)
            {
                errorMessage = "Vybraná šablona nebyla nalezena.";
                return;
            }

            // Use standard JavaScript confirm instead of custom dialog for Edge 86 compatibility
            var confirmMessage = string.Format("Tisknout štítek pro {0}, {1}-{2}?", 
                item.MaterialDescription ?? "N/A", 
                item.MaterialNumber?.ToString() ?? "N/A", 
                item.Storage ?? "N/A");
                
            var confirmed = await JS.InvokeAsync<bool>("confirm", confirmMessage);
            if (!confirmed)
            {
                return;
            }

            isPrinting = true;
            StateHasChanged();

            await MaterialStockStageService.PrintZplAsync(item, printer, template);
            
            printMessage = string.Format("Úspěšně vytištěn štítek pro číslo materiálu: {0}, šarži: {1}", 
                item.MaterialNumber?.ToString() ?? "N/A", 
                item.MaterialBatch ?? "N/A");
        }
        catch (Exception ex)
        {
            errorMessage = string.Format("Chyba při tisku štítku: {0}", ex.Message);
        }
        finally
        {
            isPrinting = false;
            StateHasChanged();
        }
    }
}
