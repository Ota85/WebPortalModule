@page "/"
@using EsonicModule.DTOs
@using EsonicModule.Services
@using Microsoft.JSInterop
@inject IMaterialStockStageService MaterialStockStageService
@inject IPrinterSettingService PrinterSettingService
@inject IZebraTemplateService ZebraTemplateService
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Data pro tisk</PageTitle>

<p>Čárové kódy skladových dat materiálu pro tisk</p>

@if (isLoading)
{
    <p><em>Načítání...</em></p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

<!-- Printer and Template Selection Section -->
<div class="section-container">
    <div class="form-row">
        <div class="form-group col-md-6">
            <label for="printerSelect" class="form-label">Tiskárna</label>
            <select class="form-control" id="printerSelect" value="@selectedPrinterId" @onchange="@(e => OnPrinterChanged(e))">
                <option value="0">-- Vyberte tiskárnu --</option>
                @foreach (var printer in printerSettings)
                {
                    <option value="@printer.Id">@printer.Name (@printer.IPAddress:@printer.Port)</option>
                }
            </select>
        </div>
        <div class="form-group col-md-6">
            <label for="templateSelect" class="form-label">Šablona</label>
            <select class="form-control" id="templateSelect" value="@selectedTemplateId" @onchange="@(e => OnTemplateChanged(e))">
                <option value="0">-- Vyberte šablonu --</option>
                @foreach (var template in zebraTemplates)
                {
                    <option value="@template.Id">@template.Name</option>
                }
            </select>
        </div>
    </div>
</div>

<!-- Date Filter Section -->
<div class="section-container">
    <div class="form-row">
        <div class="form-group col-md-3">
            <label for="filterDateFrom" class="form-label">Datum od</label>
            <input type="date" class="form-control" id="filterDateFrom" value="@(filterDateFrom?.ToString("yyyy-MM-dd"))" @onchange="@(e => OnDateFromChanged(e))" />
        </div>
        <div class="form-group col-md-3">
            <label for="filterDateTo" class="form-label">Datum do</label>
            <input type="date" class="form-control" id="filterDateTo" value="@(filterDateTo?.ToString("yyyy-MM-dd"))" @onchange="@(e => OnDateToChanged(e))" />
        </div>
        <div class="form-group col-md-6">
            <label class="form-label">&nbsp;</label>
            <div class="button-group">
                <button class="btn btn-secondary" @onclick="ClearDateFilters">Vymazat filtry dat</button>
                <button class="btn btn-primary button-spacing" @onclick="ReloadData">Znovu načíst data</button>
            </div>
        </div>
    </div>
</div>

<!-- Text Filters Section -->
<div class="section-container">
    <div class="form-row">
        <div class="form-group col-md-6">
            <label for="filterMaterialNumber" class="form-label">Číslo materiálu</label>
            <input type="text" class="form-control" id="filterMaterialNumber" 
                   value="@filterMaterialNumber" 
                   @onchange="@(e => OnMaterialNumberFilterChanged(e))"
                   placeholder="Filtrovat podle čísla materiálu" />
        </div>
        <div class="form-group col-md-3">
            <label for="filterMaterialBatch" class="form-label">Šarže materiálu</label>
            <input type="text" class="form-control" id="filterMaterialBatch" 
                   value="@filterMaterialBatch" 
                   @onchange="@(e => OnMaterialBatchFilterChanged(e))"
                   placeholder="Filtrovat podle šarže materiálu" />
        </div>
        <div class="form-group col-md-3">
            <label for="filterStorage" class="form-label">Sklad</label>
            <input type="text" class="form-control" id="filterStorage" 
                   value="@filterStorage" 
                   @onchange="@(e => OnStorageFilterChanged(e))"
                   placeholder="Filtrovat podle skladu" />
        </div>
    </div>
</div>

<!-- Data Table Section -->
<div class="table-container">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th class="sortable-header" @onclick="@(() => SortBy("MaterialNumber"))">
                    Číslo materiálu 
                    @if (sortColumn == "MaterialNumber")
                    {
                        <span>@(sortAscending ? "▲" : "▼")</span>
                    }
                </th>
                <th>Popis materiálu</th>
                <th class="sortable-header" @onclick="@(() => SortBy("MaterialBatch"))">
                    Šarže materiálu 
                    @if (sortColumn == "MaterialBatch")
                    {
                        <span>@(sortAscending ? "▲" : "▼")</span>
                    }
                </th>
                <th class="sortable-header" @onclick="@(() => SortBy("Storage"))">
                    Sklad 
                    @if (sortColumn == "Storage")
                    {
                        <span>@(sortAscending ? "▲" : "▼")</span>
                    }
                </th>
                <th class="sortable-header" @onclick="@(() => SortBy("TimeStamp"))">
                    Časové razítko 
                    @if (sortColumn == "TimeStamp")
                    {
                        <span>@(sortAscending ? "▲" : "▼")</span>
                    }
                </th>
                <th>Akce</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in FilteredData)
            {
                <tr>
                    <td>@item.MaterialNumber</td>
                    <td>@item.MaterialDescription</td>
                    <td>@item.MaterialBatch</td>
                    <td>@item.Storage</td>
                    <td>@FormatDateTime(item.TimeStamp)</td>
                    <td>
                        <button class="btn btn-primary btn-sm" @onclick="@(() => PrintItem(item))" disabled="@isPrinting">
                            <span class="bi bi-printer" aria-hidden="true"></span> 
                            @(isPrinting ? "Tiskne se..." : "Tisk")
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (FilteredData.Count == 0)
{
    <div class="alert alert-info" role="alert">
        Nebyla nalezena žádná data odpovídající aktuálním filtrům.
    </div>
}

@if (!string.IsNullOrEmpty(printMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @printMessage
        <button type="button" class="btn-close-custom" @onclick="@(() => { printMessage = string.Empty; StateHasChanged(); })">×</button>
    </div>
}

<!-- Edge 86 Compatible CSS -->
