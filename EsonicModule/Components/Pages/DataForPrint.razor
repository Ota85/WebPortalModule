@page "/"
@using EsonicModule.DTOs
@using EsonicModule.Services
@inject IMaterialStockStageService MaterialStockStageService
@inject IPrinterSettingService PrinterSettingService
@inject IZebraTemplateService ZebraTemplateService
@rendermode InteractiveServer

<PageTitle>Data for Print</PageTitle>

@* <h1>Material stock data for printing</h1> *@

<p>Material stock data barcodes for printing</p>

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}
else
{
    <div class="mb-3 p-3 border rounded" style="background-color: #f8f9fa;">
        <div class="row g-3">
            <div class="col-md-6">
                <label for="printerSelect" class="form-label">Printer</label>
                <select class="form-select" id="printerSelect" @bind="selectedPrinterId">
                    <option value="0">-- Select Printer --</option>
                    @foreach (var printer in printerSettings)
                    {
                        <option value="@printer.Id">@printer.Name (@printer.IPAddress:@printer.Port)</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label for="templateSelect" class="form-label">Template</label>
                <select class="form-select" id="templateSelect" @bind="selectedTemplateId">
                    <option value="0">-- Select Template --</option>
                    @foreach (var template in zebraTemplates)
                    {
                        <option value="@template.Id">@template.Name</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <div class="mb-3 p-3 border rounded" style="background-color: #f8f9fa;">
        <div class="row g-3">
            <div class="col-md-3">
                <label for="filterDateFrom" class="form-label">Date From</label>
                <input type="date" class="form-control" id="filterDateFrom" @bind="filterDateFrom" />
            </div>
            <div class="col-md-3">
                <label for="filterDateTo" class="form-label">Date To</label>
                <input type="date" class="form-control" id="filterDateTo" @bind="filterDateTo" />
            </div>
            <div class="col-md-6">
                <label class="form-label">&nbsp;</label>
                <div>
                    <button class="btn btn-secondary" @onclick="ClearDateFilters">Clear Date Filters</button>
                    <button class="btn btn-primary me-2" @onclick="ReloadData">Data Reload</button>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-3">
        <div class="row g-3">
            <div class="col-md-6">
                <label for="filterMaterialNumber" class="form-label">Material Number</label>
                <input type="text" class="form-control" id="filterMaterialNumber" @bind="filterMaterialNumber" @bind:event="oninput" @bind:after="UpdateFilteredData" placeholder="Filter by Material Number" />
            </div>
            <div class="col-md-3">
                <label for="filterMaterialBatch" class="form-label">Material Batch</label>
                <input type="text" class="form-control" id="filterMaterialBatch" @bind="filterMaterialBatch" @bind:event="oninput" @bind:after="UpdateFilteredData" placeholder="Filter by Material Batch" />
            </div>
            <div class="col-md-3">
                <label for="filterStorage" class="form-label">Storage</label>
                <input type="text" class="form-control" id="filterStorage" @bind="filterStorage" @bind:event="oninput" @bind:after="UpdateFilteredData" placeholder="Filter by Storage" />
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th style="cursor: pointer;" @onclick="@(() => SortBy("MaterialNumber"))">
                        Material Number 
                        @if (sortColumn == "MaterialNumber")
                        {
                            <span>@(sortAscending ? "▲" : "▼")</span>
                        }
                    </th>
                    <th>Material Description</th>
                    <th style="cursor: pointer;" @onclick="@(() => SortBy("MaterialBatch"))">
                        Material Batch 
                        @if (sortColumn == "MaterialBatch")
                        {
                            <span>@(sortAscending ? "▲" : "▼")</span>
                        }
                    </th>
                    <th style="cursor: pointer;" @onclick="@(() => SortBy("Storage"))">
                        Storage 
                        @if (sortColumn == "Storage")
                        {
                            <span>@(sortAscending ? "▲" : "▼")</span>
                        }
                    </th>
                    <th style="cursor: pointer;" @onclick="@(() => SortBy("TimeStamp"))">
                        Timestamp 
                        @if (sortColumn == "TimeStamp")
                        {
                            <span>@(sortAscending ? "▲" : "▼")</span>
                        }
                    </th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in FilteredData)
                {
                    <tr>
                        <td>@item.MaterialNumber</td>
                        <td>@item.MaterialDescription</td>
                        <td>@item.MaterialBatch</td>
                        <td>@item.Storage</td>
                        <td>@(item.TimeStamp?.ToString("yyyy-MM-dd HH:mm:ss"))</td>
                        <td>
                            <button class="btn btn-primary btn-sm" @onclick="@(() => PrintItem(item))" disabled="@isPrinting">
                                <span class="bi bi-printer" aria-hidden="true"></span> 
                                @(isPrinting ? "Printing..." : "Print")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (FilteredData.Count == 0)
    {
        <div class="alert alert-info" role="alert">
            No data found matching the current filters.
        </div>
    }

    @if (!string.IsNullOrEmpty(printMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @printMessage
            <button type="button" class="btn-close" @onclick="@(() => printMessage = string.Empty)"></button>
        </div>
    }
}

@code {
    private List<MaterialStockStageDto> materialStockStages = new();
    private List<MaterialStockStageDto>? cachedFilteredData;
    private List<PrinterSettingDto> printerSettings = new();
    private List<ZebraTemplateDto> zebraTemplates = new();
    private int selectedPrinterId = 0;
    private int selectedTemplateId = 0;
    private bool isLoading = true;
    private string? errorMessage;
    private bool isPrinting = false;
    private string printMessage = string.Empty;
    
    // Date filtering
    private DateTime? filterDateFrom;
    private DateTime? filterDateTo;
    
    // Filtering
    private string filterMaterialBatch = string.Empty;
    private string filterMaterialNumber = string.Empty;
    private string filterStorage = string.Empty;
    
    // Sorting
    private string sortColumn = string.Empty;
    private bool sortAscending = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Initial load without date filters - loads top 250 by TimeStamp descending
            materialStockStages = await MaterialStockStageService.GetAllAsync() ?? new();
            printerSettings = await PrinterSettingService.GetAllAsync() ?? new();
            zebraTemplates = await ZebraTemplateService.GetAllAsync() ?? new();
            UpdateFilteredData();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading material stock data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ReloadData()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            StateHasChanged();

            // Reload data from service with date filters
            materialStockStages = await MaterialStockStageService.GetAllAsync(filterDateFrom, filterDateTo) ?? new();
            UpdateFilteredData();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading material stock data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ClearDateFilters()
    {
        filterDateFrom = null;
        filterDateTo = null;
        await ReloadData();
    }

    private List<MaterialStockStageDto> FilteredData => cachedFilteredData ?? new List<MaterialStockStageDto>();

    private void UpdateFilteredData()
    {
        var filtered = materialStockStages.AsEnumerable();

        // Apply filters
        if (!string.IsNullOrWhiteSpace(filterMaterialNumber))
        {
            filtered = filtered.Where(x => 
                x.MaterialNumber.HasValue && 
                x.MaterialNumber.Value.ToString().Contains(filterMaterialNumber));
        }

        if (!string.IsNullOrWhiteSpace(filterMaterialBatch))
        {
            filtered = filtered.Where(x => 
                !string.IsNullOrEmpty(x.MaterialBatch) && 
                x.MaterialBatch.Contains(filterMaterialBatch, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(filterStorage))
        {
            filtered = filtered.Where(x => 
                !string.IsNullOrEmpty(x.Storage) && 
                x.Storage.Contains(filterStorage, StringComparison.OrdinalIgnoreCase));
        }

        // Apply sorting
        if (!string.IsNullOrEmpty(sortColumn))
        {
            filtered = sortColumn switch
            {
                "MaterialNumber" => sortAscending 
                    ? filtered.OrderBy(x => x.MaterialNumber) 
                    : filtered.OrderByDescending(x => x.MaterialNumber),
                "MaterialBatch" => sortAscending 
                    ? filtered.OrderBy(x => x.MaterialBatch) 
                    : filtered.OrderByDescending(x => x.MaterialBatch),
                "Storage" => sortAscending 
                    ? filtered.OrderBy(x => x.Storage) 
                    : filtered.OrderByDescending(x => x.Storage),
                "TimeStamp" => sortAscending 
                    ? filtered.OrderBy(x => x.TimeStamp) 
                    : filtered.OrderByDescending(x => x.TimeStamp),
                _ => filtered
            };
        }

        cachedFilteredData = filtered.ToList();
    }

    private void SortBy(string columnName)
    {
        if (sortColumn == columnName)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = columnName;
            sortAscending = true;
        }
        UpdateFilteredData();
    }

    private async Task PrintItem(MaterialStockStageDto item)
    {
        try
        {
            printMessage = string.Empty;
            errorMessage = string.Empty;

            // Validate selections
            if (selectedPrinterId == 0)
            {
                errorMessage = "Please select a printer.";
                return;
            }

            if (selectedTemplateId == 0)
            {
                errorMessage = "Please select a template.";
                return;
            }

            var printer = printerSettings.FirstOrDefault(p => p.Id == selectedPrinterId);
            var template = zebraTemplates.FirstOrDefault(t => t.Id == selectedTemplateId);

            if (printer == null)
            {
                errorMessage = "Selected printer not found.";
                return;
            }

            if (template == null)
            {
                errorMessage = "Selected template not found.";
                return;
            }

            isPrinting = true;
            StateHasChanged();

            await MaterialStockStageService.PrintZplAsync(item, printer, template);
            
            printMessage = $"Successfully printed label for Material Number: {item.MaterialNumber}, Batch: {item.MaterialBatch}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error printing label: {ex.Message}";
        }
        finally
        {
            isPrinting = false;
            StateHasChanged();
        }
    }
}
